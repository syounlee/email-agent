# Copy this file to .env and fill in your values. Never commit .env.

# Your Anthropic API key (from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Claude model the agent uses
MODEL=claude-sonnet-5-5

# Stop a single agent run once it has spent this many US dollars
MAX_BUDGET_USD=0.50

# Stop a single agent run after this many back-and-forth turns
MAX_TURNS=20

# Folder for the agent's working data, including the email database
# (emails.db). Relative paths are inside the project folder.
DATA_DIR=data/

# Which mailbox the agent uses: demo (the 15 sample emails) or imap (your real
# email, read-only). Demo and imap keep separate databases in DATA_DIR.
MAILBOX=demo

# For MAILBOX=imap: your email address. The provider (gmail, outlook, icloud,
# yahoo) is guessed from it; set EMAIL_PROVIDER to override, e.g. for your own
# domain hosted by Google (gmail) or Microsoft (outlook). Anything else: other,
# plus IMAP_HOST below.
EMAIL_ADDRESS=
EMAIL_PROVIDER=

# Gmail, iCloud Mail, Yahoo Mail, others: an *app password* made by your
# provider for this app (not your normal password). See the README.
EMAIL_APP_PASSWORD=

# Outlook / Hotmail / Live only: Microsoft doesn't accept passwords, so register
# the app once (README: "Outlook, Hotmail, Live") and paste its
# "Application (client) ID" here. Then run:  uv run email-connect
OUTLOOK_CLIENT_ID=

# IMAP server: empty = the provider's own (imap.gmail.com, outlook.office365.com,
# imap.mail.me.com, imap.mail.yahoo.com). Set it for any other provider.
IMAP_HOST=
IMAP_FOLDER=INBOX

# How much mail to copy into the database on each sync. If you only start the
# agent now and then, raise these so it catches up on everything in between
# (e.g. SYNC_MAX_EMAILS=500 and SYNC_DAYS=14).
SYNC_MAX_EMAILS=30
SYNC_DAYS=7

# Local web server (uv run email-agent): only reachable from this computer
PORT=3000

# Phone alerts for important emails, via the free ntfy app (https://ntfy.sh).
# NTFY_TOPIC works like a password: pick something long and random, e.g. from
#   uv run python -c "import secrets; print('ea-' + secrets.token_urlsafe(18))"
# and subscribe to the same topic in the ntfy app. Empty = no phone alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# When the summary of less urgent alerts goes out (while email-watch runs):
#   8        once a day at 8:00 (or when you start it, if later)
#   8-22     every hour from 8:00 to 22:00 (an hour with nothing new sends nothing;
#            alerts after 22:00 wait for 8:00)
#   8,13,18  at these hours
# Urgent alerts always go out right away.
SUMMARY_HOURS=8

# Sender domains whose mail always alerts you right away (the work-alerts
# listener), comma-separated, e.g. WORK_SENDERS=mycompany.com,jobs.example.org
# Kept here rather than in the code because it says where you work. Empty = off.
WORK_SENDERS=
