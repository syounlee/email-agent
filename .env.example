# Copy this file to .env and fill in your values. Never commit .env.

# Your Anthropic API key (from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Claude model the agent uses
MODEL=claude-sonnet-5-5

# Stop a single agent run once it has spent this many US dollars
MAX_BUDGET_USD=0.50

# Stop a single agent run after this many back-and-forth turns
MAX_TURNS=20

# Folder where the agent keeps its working data (relative to the project folder)
DATA_DIR=data/
