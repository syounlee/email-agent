# Copy this file to .env and fill in your values. Never commit .env.

# Your Anthropic API key (from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Claude model the agent uses
MODEL=claude-sonnet-5-5

# Stop a single agent run once it has spent this many US dollars
MAX_BUDGET_USD=0.50

# Stop a single agent run after this many back-and-forth turns
MAX_TURNS=20

# Folder for the agent's working data, including the email database
# (emails.db). Relative paths are inside the project folder.
DATA_DIR=data/

# Which mailbox the agent uses: demo (the 15 sample emails) or imap (your real
# email, read-only). Demo and imap keep separate databases in DATA_DIR.
MAILBOX=demo

# For MAILBOX=imap: your Gmail address and a Gmail *app password*
# (16 letters, not your normal password). See README steps in the chat.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# IMAP server and folder (Gmail defaults)
IMAP_HOST=imap.gmail.com
IMAP_FOLDER=INBOX

# How much mail to copy into the database on each sync. If you only start the
# agent now and then, raise these so it catches up on everything in between
# (e.g. SYNC_MAX_EMAILS=500 and SYNC_DAYS=14).
SYNC_MAX_EMAILS=30
SYNC_DAYS=7

# Local web server (uv run email-agent): only reachable from this computer
PORT=3000

# Phone alerts for important emails, via the free ntfy app (https://ntfy.sh).
# NTFY_TOPIC works like a password: pick something long and random, e.g. from
#   uv run python -c "import secrets; print('ea-' + secrets.token_urlsafe(18))"
# and subscribe to the same topic in the ntfy app. Empty = no phone alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# The morning summary of less urgent alerts goes out at this hour (0-23),
# or when you start the agent, if that is later.
SUMMARY_HOUR=8
